{
  "name": "@carbon/echarts-toolbar",
  "version": "0.4.0",
  "description": "Carbon-styled toolbar for Apache ECharts — show as table, fullscreen, and export",
  "homepage": "https://github.com/carbon-design-system/carbon-echarts-theme#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-design-system/carbon-echarts-theme.git",
    "directory": "packages/toolbar"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./styles": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsup && sass src/styles/toolbar.scss dist/styles.css --style=compressed --no-source-map",
    "dev": "tsup --watch",
    "postinstall": "ibmtelemetry --config=telemetry.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "echarts": ">=6.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "echarts": "^6.1.0",
    "sass": "^1.89.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@ibm/telemetry-js": "^1.11.0"
  }
}
